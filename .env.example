# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# GitHub Personal Access Token (scope: public_repo)
# Tạo tại: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=

# Gemini API key (Milestone 4 mới cần)
# Tạo tại: https://aistudio.google.com
GEMINI_API_KEY=
