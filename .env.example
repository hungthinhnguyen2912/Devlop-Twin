# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# GitHub Personal Access Token (scope: public_repo)
# Tạo tại: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=

# Gemini API key (GOOGLE_API_KEY là tên Google hiện khuyến nghị)
# Tạo tại: https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# PostgreSQL (các giá trị mặc định khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtwin
DB_USERNAME=devtwin
DB_PASSWORD=devtwin
